rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isProjectMember(projectData) {
      return isAuthenticated() && (
        projectData.userId == request.auth.uid ||
        projectData.ownerId == request.auth.uid ||
        projectData.createdBy == request.auth.uid ||
        (projectData.collaborators != null && request.auth.uid in projectData.collaborators)
      );
    }

    // ── User Profiles & Settings ──────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Subcollection for user's diagrams / projects
      match /projects/{projectId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Root-level Projects ───────────────────────────────────────────
    // Phase 2 Container holding multiple diagrams
    match /projects/{projectId} {
      // Allow read if user is owner, collaborator, or project is explicitly public
      allow read: if isAuthenticated() && (
        isProjectMember(resource.data) ||
        resource.data.isPublic == true
      );

      // Allow create only if creator sets themselves as ownerId / userId
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.createdBy == request.auth.uid
      );

      // Allow update if owner or collaborator
      allow update: if isAuthenticated() && isProjectMember(resource.data);

      // Only owner can delete their project
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid
      );

      // Subcollection: Diagrams inside this project container
      match /diagrams/{diagramId} {
        allow read: if isAuthenticated() && (
          isProjectMember(get(/databases/$(database)/documents/projects/$(projectId)).data) ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.isPublic == true
        );

        allow create, update: if isAuthenticated() &&
          isProjectMember(get(/databases/$(database)/documents/projects/$(projectId)).data);

        allow delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.createdBy == request.auth.uid
        );
      }
    }

    // ── Root-level Diagrams (Direct access or independent documents) ──
    match /diagrams/{diagramId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        (resource.data.collaborators != null && request.auth.uid in resource.data.collaborators) ||
        resource.data.isPublic == true
      );

      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.createdBy == request.auth.uid
      );

      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        (resource.data.collaborators != null && request.auth.uid in resource.data.collaborators)
      );

      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid
      );
    }

    // ── Default Deny ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
